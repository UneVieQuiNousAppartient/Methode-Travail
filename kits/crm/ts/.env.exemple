# Kit CRM TS (methode-travail) — origine : écrit pour le kit (toutes les variables du lot 1, sans valeur).
# Copier dans .env.local (jamais suivi par Git) et dans les variables du projet Vercel.

# --- Adresse du site (src/lib/site/site-url.ts) ---
# https, sans chemin ni barre finale. Vide : repli sur VERCEL_PROJECT_PRODUCTION_URL (posée par Vercel).
NEXT_PUBLIC_SITE_URL=

# --- Supabase (src/lib/supabase/server-admin.ts, CSP) ---
NEXT_PUBLIC_SUPABASE_URL=
# Serveur seulement. Jamais NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anti-abus (src/lib/api/abuse-guard.ts) ---
# Secret des empreintes HMAC (32 caractères aléatoires ou plus). Vide : CRON_SECRET, puis SUPABASE_SERVICE_ROLE_KEY.
RATE_LIMIT_PEPPER=

# --- Turnstile (src/lib/api/turnstile.ts) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 1 = jeton obligatoire (après avoir équipé tous les formulaires). Avec 1 et sans clé secrète : refus 503.
TURNSTILE_ENFORCE=
# Facultatif : nom(s) d'hôte attendu(s) dans la réponse de Cloudflare, séparés par des virgules.
TURNSTILE_EXPECTED_HOSTNAME=

# --- CSP (src/lib/security/csp-policy.mjs, next.config) ---
# Vide ou « observation » : Report-Only (défaut d'un nouveau projet). « actif » : bloquante. Lu au build.
CSP_MODE=
# Origines tierces https exactes, séparées par des virgules (ex. un CDN d'images). Vide : aucune.
CSP_EXTRA_ORIGINS=

# --- Tâches planifiées (src/lib/cron/auth.ts) ---
# Envoyé par Vercel Cron en « Authorization: Bearer ». 32 caractères aléatoires ou plus.
CRON_SECRET=

# --- Courriels (src/lib/email/envoi.ts) ---
RESEND_API_KEY=
# Adresse d'un domaine vérifié dans Resend (SPF, DKIM, DMARC), ex. « Nom <bonjour@domaine> ».
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- Loi anti-pourriel (src/lib/email/lcap.ts, desabonnement.ts, route /api/desabonnement) ---
# Secret des liens de désabonnement, 32 caractères ou plus (sinon CRON_SECRET s'il est assez long). Ne pas le changer : les liens envoyés deviendraient invalides.
UNSUBSCRIBE_SECRET=
# Adresse postale de l'entreprise, obligatoire dans tout courriel commercial. Vide : aucun envoi commercial.
LCAP_POSTAL_ADDRESS=
# Table des demandes (défaut : leads).
LCAP_LEADS_TABLE=
# Nom affiché sur la page de désabonnement, et courriel de contact (facultatifs).
SITE_NAME=
CONTACT_EMAIL=
