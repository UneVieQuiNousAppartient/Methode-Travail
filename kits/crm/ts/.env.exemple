# Kit CRM TS (methode-travail) — origine : écrit pour le kit (toutes les variables du lot 1, sans valeur).
# Copier dans .env.local (jamais suivi par Git) et dans les variables du projet Vercel.

# --- Adresse du site (src/lib/site/site-url.ts) ---
# https, sans chemin ni barre finale. Vide : repli sur VERCEL_PROJECT_PRODUCTION_URL (posée par Vercel).
NEXT_PUBLIC_SITE_URL=

# --- Supabase (src/lib/supabase/server-admin.ts, CSP) ---
NEXT_PUBLIC_SUPABASE_URL=
# Serveur seulement. Jamais NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anti-abus (src/lib/api/abuse-guard.ts) ---
# Secret des empreintes HMAC (32 caractères aléatoires ou plus). Vide : CRON_SECRET, puis SUPABASE_SERVICE_ROLE_KEY.
RATE_LIMIT_PEPPER=

# --- Turnstile (src/lib/api/turnstile.ts) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 1 = jeton obligatoire (après avoir équipé tous les formulaires). Avec 1 et sans clé secrète : refus 503.
TURNSTILE_ENFORCE=
# Facultatif : nom(s) d'hôte attendu(s) dans la réponse de Cloudflare, séparés par des virgules.
TURNSTILE_EXPECTED_HOSTNAME=

# --- CSP (src/lib/security/csp-policy.mjs, next.config) ---
# Vide ou « observation » : Report-Only (défaut d'un nouveau projet). « actif » : bloquante. Lu au build.
CSP_MODE=
# Origines tierces https exactes, séparées par des virgules (ex. un CDN d'images). Vide : aucune.
CSP_EXTRA_ORIGINS=

# --- Tâches planifiées (src/lib/cron/auth.ts) ---
# Envoyé par Vercel Cron en « Authorization: Bearer ». 32 caractères aléatoires ou plus.
CRON_SECRET=

# --- Courriels (src/lib/email/envoi.ts) ---
RESEND_API_KEY=
# Adresse d'un domaine vérifié dans Resend (SPF, DKIM, DMARC), ex. « Nom <bonjour@domaine> ».
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- Loi anti-pourriel (src/lib/email/lcap.ts, desabonnement.ts, route /api/desabonnement) ---
# Secret des liens de désabonnement, 32 caractères ou plus (sinon CRON_SECRET s'il est assez long). Ne pas le changer : les liens envoyés deviendraient invalides.
UNSUBSCRIBE_SECRET=
# Adresse postale de l'entreprise, obligatoire dans tout courriel commercial. Vide : aucun envoi commercial.
LCAP_POSTAL_ADDRESS=
# Table des demandes (défaut : leads).
LCAP_LEADS_TABLE=
# Nom affiché sur la page de désabonnement, et courriel de contact (facultatifs).
SITE_NAME=
CONTACT_EMAIL=

# ===================== Lot 2 : admin d'équipe (src/lib/auth, authz, audit, privacy) =====================

# --- Supabase côté navigateur (src/lib/auth/mfa-supabase.ts : client au nom du membre) ---
# Clé publique « anon ». Les tables de l'admin n'ont aucun droit pour anon (RLS sans politique, revoke all).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Double vérification (src/lib/auth/mfa.ts, mfa-trust.ts) ---
# 1 = code exigé pour toute l'équipe (inscription obligatoire à la prochaine connexion). Vide : exigé pour les
# membres inscrits (ou qui ont des codes de secours) et pour les rôles listés dans le code (MFA_ALWAYS_ROLES).
ADMIN_MFA_REQUIRED=
# Nom affiché dans l'application d'authentification. Vide : SITE_NAME.
MFA_ISSUER=
# Nom du témoin « appareil de confiance » (30 jours). Vide : mfa_device.
MFA_TRUST_COOKIE=

# --- Codes de secours (src/lib/auth/mfa-backup-codes.ts) ---
# Clé des empreintes HMAC, 32 caractères aléatoires ou plus, AUCUN repli : vide ou trop court = aucun code
# généré ni accepté. La changer rend tous les codes déjà remis inutilisables (en générer une nouvelle série).
MFA_BACKUP_SECRET=

# --- Mot de passe partagé (src/lib/admin/token-mode.ts) ---
# Le kit ne fournit pas de mode jeton. 1 = l'autoriser avec `next start` hors Vercel (jamais sur Vercel).
ADMIN_TOKEN_MODE_LOCAL=

# --- Loi 25 (src/lib/privacy/) ---
# Clé des empreintes des courriels effacés, 32 caractères ou plus, AUCUN repli (pas même UNSUBSCRIBE_SECRET) :
# vide ou trop courte = effacement refusé. Ne pas la changer : les empreintes déjà écrites ne bloqueraient plus
# les adresses effacées.
PRIVACY_HASH_SECRET=
# Durée de conservation en mois, OBLIGATOIRE pour la purge (aucun défaut). Exemple : 36 [à adapter] ;
# les factures suivent la loi fiscale, pas cette durée.
RETENTION_MONTHS=
